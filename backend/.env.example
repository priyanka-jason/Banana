# Copy this file to `.env` and fill in the values. Never commit `.env`.
# The Supabase project owner can share the real values with you privately.

# Project URL, like https://abcdefgh.supabase.co. Switches on sign-in checks for /api/lists.
# Not a secret: the website uses it too.
SUPABASE_URL=

# Limited key, safe for the browser. What it can do is controlled by row level security.
SUPABASE_ANON_KEY=

# Admin key. Backend scripts only. NEVER put it in the front end or on GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# Database connection, so the API and `npm run ingest -- --database` use Supabase instead of memory.
# Supabase dashboard > Connect > "Session pooler" connection string, with the database password
# filled in. This is a SECRET: it can read and change everything in the database.
DATABASE_URL=

# Encryption for DATABASE_URL: off (only for a database on this computer), require (default for
# remote databases: encrypted), or verify (encrypted and certificate checked; needs DATABASE_SSL_CA,
# the path to Supabase's CA certificate from Project Settings > Database).
DATABASE_SSL=
DATABASE_SSL_CA=
