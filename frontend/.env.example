# Direct Supabase Data API. Only browser-safe configuration goes here.
# Copy to .env.local and fill these values, then restart Vite.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Optional: show notes about data the backend does not supply yet
# VITE_SHOW_BACKEND_GAPS=1

# Optional: Stripe Payment Link for the Premium plan (Stripe dashboard → Payment
# Links). Public by design: it only opens Stripe's own checkout page. Never put a
# Stripe secret key (sk_...) here. Without it, Subscribe shows "Opening soon".
# VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/...
